import json, os, time, requests

TOKEN = os.environ["IG_ACCESS_TOKEN"]
IG_ID = os.environ["IG_ACCOUNT_ID"]
BASE = "https://graph.facebook.com/v21.0"

# কোন গুলো post করা হয়েছে তা পড়া
with open("posts.json") as f:
    posts = json.load(f)
with open("posted.json") as f:
    posted = json.load(f)

# পরবর্তী যেটা post হয়নি সেটা বেছে নেওয়া
next_post = next((p for p in posts if p["id"] not in posted), None)
if not next_post:
    print("সব post হয়ে গেছে। নতুন content যোগ করুন।")
    exit(0)

# ধাপ ১: media container তৈরি
params = {"caption": next_post["caption"], "access_token": TOKEN}
if next_post["type"] == "REELS":
    params["media_type"] = "REELS"
    params["video_url"] = next_post["media_url"]
else:
    params["image_url"] = next_post["media_url"]

r = requests.post(f"{BASE}/{IG_ID}/media", data=params)
r.raise_for_status()
creation_id = r.json()["id"]

# ভিডিও হলে process হতে কিছু সময় অপেক্ষা
if next_post["type"] == "REELS":
    for _ in range(20):
        s = requests.get(f"{BASE}/{creation_id}",
                         params={"fields": "status_code", "access_token": TOKEN}).json()
        if s.get("status_code") == "FINISHED":
            break
        time.sleep(15)

# ধাপ ২: publish করা
pub = requests.post(f"{BASE}/{IG_ID}/media_publish",
                    data={"creation_id": creation_id, "access_token": TOKEN})
pub.raise_for_status()
print("Posted:", next_post["id"], pub.json())

# posted.json আপডেট করা
posted.append(next_post["id"])
with open("posted.json", "w") as f:
    json.dump(posted, f, indent=2)
